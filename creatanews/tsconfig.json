{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-build/types/**/*.ts",
    ".next-build/dev/types/**/*.ts",
    ".next-release/types/**/*.ts",
    ".next-release/dev/types/**/*.ts",
    ".next-charts-build/types/**/*.ts",
    ".next-charts-build/dev/types/**/*.ts",
    ".next-demo/types/**/*.ts",
    ".next-demo/dev/types/**/*.ts",
    ".next-full-demo-dev/types/**/*.ts",
    ".next-full-demo-dev/dev/types/**/*.ts",
    ".next-full-demo/types/**/*.ts",
    ".next-full-demo/dev/types/**/*.ts",
    ".next-full-demo-final/types/**/*.ts",
    ".next-full-demo-final/dev/types/**/*.ts",
    ".next-editorial-home/types/**/*.ts",
    ".next-editorial-home/dev/types/**/*.ts",
    ".next-editorial-home-final/types/**/*.ts",
    ".next-editorial-home-final/dev/types/**/*.ts",
    ".next-editorial-home-reference/types/**/*.ts",
    ".next-editorial-home-reference/dev/types/**/*.ts",
    ".next-editorial-home-release/types/**/*.ts",
    ".next-editorial-home-release/dev/types/**/*.ts",
    ".next-compact-promo-footer/types/**/*.ts",
    ".next-compact-promo-footer/dev/types/**/*.ts",
    ".next-home-redesign-v2/types/**/*.ts",
    ".next-home-redesign-v2/dev/types/**/*.ts",
    ".next-approved-home/types/**/*.ts",
    ".next-approved-home/dev/types/**/*.ts",
    ".next-approved-home-production/types/**/*.ts",
    ".next-approved-home-production/dev/types/**/*.ts",
    ".next-home-variants/types/**/*.ts",
    ".next-home-variants/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "e2e"
  ]
}
