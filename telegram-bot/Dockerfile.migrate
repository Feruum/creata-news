# syntax=docker/dockerfile:1
FROM oven/bun:1.4.2-alpine@sha256:d888c0ae6c86d7866ff10c5aafdd9077b36aee6455b33dd270fb93c0dd5cef6f

WORKDIR /app

ARG SERVICE_VERSION=1.0.0
ARG GIT_COMMIT=unknown
ARG BUILD_TIME=unknown

LABEL org.opencontainers.image.source="https://github.com/StudyVerseApp/ems-monorepo" \
      org.opencontainers.image.version="${SERVICE_VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_TIME}"

COPY package.json bun.lock nx.json tsconfig.base.json ./
COPY apps/agent-admin/package.json ./apps/agent-admin/
COPY apps/events-admin/package.json ./apps/events-admin/
COPY apps/map/package.json ./apps/map/
COPY apps/sundayopen/package.json ./apps/sundayopen/
COPY apps/telegram-bot/package.json ./apps/telegram-bot/
COPY packages/db/package.json ./packages/db/
COPY packages/env/package.json ./packages/env/
COPY packages/proto/package.json ./packages/proto/
COPY packages/registration-forms/package.json ./packages/registration-forms/
COPY scripts/release/install-dependencies.sh /app/install-dependencies.sh
RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked sh /app/install-dependencies.sh

COPY apps/telegram-bot/drizzle.config.ts ./apps/telegram-bot/drizzle.config.ts
COPY apps/telegram-bot/drizzle ./apps/telegram-bot/drizzle

RUN addgroup --system --gid 1001 migrator && adduser --system --uid 1001 migrator
USER migrator
WORKDIR /app/apps/telegram-bot

CMD ["bun", "run", "db:migrate"]
