# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=http://localhost:3001/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=local-webhook-secret
# Same secret as backend INTERNAL_REMINDER_SECRET; authenticates reminder RPCs and /notify endpoints.
# Use 32+ random characters in production. An empty value disables internal HTTP notifications.
INTERNAL_REMINDER_SECRET=
ENVIRONMENT=development

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/telegram_bot

# External Services
SCHEDULE_API_URL=http://localhost:8081
# HTTPS enables Telegram Mini App buttons and the default «Открыть карту» menu.
# For local development http://localhost:3000 falls back to regular links and the command menu.
MAP_APP_URL=https://map.webspace.cat
EMS_API_URL=https://api.studyverse.app

# Timezone
TIMEZONE=Asia/Almaty
