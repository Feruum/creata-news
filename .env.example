# Copy to .env or run bun run setup:local. Never commit .env.
CREATA_ENV=development
DATABASE_URL=postgres://creata:creata-local@127.0.0.1:54328/creata?sslmode=disable
POSTGRES_PASSWORD=creata-local
CREATA_SESSION_SECRET=
CREATA_WORKER_TOKEN=
CREATA_BOT_SERVICE_TOKEN=
# Shared by the public frontend's server runtime and API only.
CREATA_SSR_TOKEN=
# Comma-separated IPv4/IPv6 CIDRs of trusted ingress and application proxies.
CREATA_TRUSTED_PROXIES=
CREATA_DEV_AUTH=1
CREATA_ORIGINS=http://localhost:3002,http://localhost:6868,http://localhost:5174
CREATA_PUBLIC_URL=http://localhost:3002
CREATA_EDITORIAL_URL=http://localhost:6868
CREATA_HERMES_ADMIN_URL=http://localhost:5174
CREATA_COOKIE_DOMAIN=
CREATA_API_ORIGIN=http://localhost:5555
CREATA_GOOGLE_CLIENT_ID=
CREATA_GOOGLE_CLIENT_SECRET=
CREATA_API_URL=http://localhost:5555
# Optional fixed local ports. Empty values choose free ports near defaults.
CREATA_API_PORT=
CREATA_WEB_PORT=
CREATA_EDITORIAL_PORT=
CREATA_HERMES_PORT=
CREATA_BOT_PORT=
CREATA_PYTHON=
CREATA_WORKER_STATE_DIR=./.runtime/hermes-state
TELEGRAM_BOT_TOKEN=
CREATA_TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
CREATA_TELEGRAM_CHANNEL_ID=
CREATA_TELEGRAM_CHANNEL_ONLY=0
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_COLLECTOR_SESSION=
TELEGRAM_COLLECTOR_SESSION_FILE=
# AI endpoint/model/key/prices/budget configured via Hermes panel.
CREATA_MEDIA_DIR=./uploads

CREATA_TELEGRAM_CLIENT_ID=
CREATA_TELEGRAM_CLIENT_SECRET=
CREATA_S3_ENDPOINT=
CREATA_S3_REGION=us-east-1
CREATA_S3_BUCKET=
CREATA_S3_ACCESS_KEY=
CREATA_S3_SECRET_KEY=
CREATA_MEDIA_PUBLIC_URL=

# Postiz public API. Select accounts per publication in the editorial app.
CREATA_POSTIZ_API_URL=https://api.postiz.com/public/v1
CREATA_POSTIZ_API_KEY=
CREATA_POSTIZ_MODE=draft
